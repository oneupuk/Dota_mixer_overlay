<!--
  Dota Glass Overlay - visual layout.
  Loaded at runtime (XamlReader), so you can tweak colors/sizes here and just rebuild.
  Design units are "1080p pixels": the whole thing is scaled to match Dota's HUD size.
  Keep the root size in sync with OverlayWindow.BaseWidth / BaseHeight / BaseRadius.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" Width="360" Height="72" Background="Transparent"
      TextElement.FontFamily="Segoe UI" TextElement.Foreground="White">

  <Grid.Resources>
    <Style x:Key="GlassButton" TargetType="Border">
      <Setter Property="Background" Value="#00FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#2EFFFFFF"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.35"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- The play button is a little glass "lens" of its own -->
    <Style x:Key="GlassLens" TargetType="Border">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#14FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B3FFFFFF" Offset="0"/>
            <GradientStop Color="#14FFFFFF" Offset="0.55"/>
            <GradientStop Color="#59FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background">
            <Setter.Value>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#66FFFFFF" Offset="0"/>
                <GradientStop Color="#26FFFFFF" Offset="1"/>
              </LinearGradientBrush>
            </Setter.Value>
          </Setter>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.35"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TimeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="Foreground" Value="#B3FFFFFF"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
  </Grid.Resources>

  <!-- ============ Glass body (sits on top of the DWM backdrop blur) ============ -->
  <Grid IsHitTestVisible="False">
    <Grid.Clip>
      <RectangleGeometry Rect="0,0,360,72" RadiusX="24" RadiusY="24"/>
    </Grid.Clip>
    <!-- tint: keeps white text readable over bright terrain -->
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#33404858" Offset="0"/>
          <GradientStop Color="#590C0F14" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <!-- caustic sheen, top-left -->
    <Rectangle>
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.2,0" GradientOrigin="0.2,0" RadiusX="0.6" RadiusY="1.3">
          <GradientStop Color="#38FFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <!-- light bouncing back from the bottom-right edge -->
    <Rectangle>
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.85,1.15" GradientOrigin="0.85,1.15" RadiusX="0.45" RadiusY="0.95">
          <GradientStop Color="#24FFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
  </Grid>

  <!-- specular rim (bright top-left, catches light again bottom-right) -->
  <Border CornerRadius="24" BorderThickness="1.25" IsHitTestVisible="False">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#4DFFFFFF" Offset="0.22"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#40FFFFFF" Offset="0.82"/>
        <GradientStop Color="#A6FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
  </Border>
  <!-- inner refraction rim: gives the edge its "thickness" -->
  <Border CornerRadius="22.75" Margin="1.25" BorderThickness="1" IsHitTestVisible="False">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.35"/>
        <GradientStop Color="#00FFFFFF" Offset="0.7"/>
        <GradientStop Color="#1FFFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
  </Border>

  <!-- ============ Content ============ -->
  <Grid Margin="10,10,12,10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="52"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="94"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="14"/>
    </Grid.RowDefinitions>

    <!-- Artwork -->
    <Grid Grid.RowSpan="2" Width="52" Height="52">
      <Border x:Name="ArtFallback" CornerRadius="14">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#59FFFFFF" Offset="0"/>
            <GradientStop Color="#14FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Path Width="20" Height="20" Stretch="Uniform" Fill="#E6FFFFFF"
              Data="M12,3 V13.55 C11.41,13.21 10.73,13 10,13 C7.79,13 6,14.79 6,17 C6,19.21 7.79,21 10,21 C12.21,21 14,19.21 14,17 V7 H18 V3 Z"/>
      </Border>
      <Border x:Name="Art" CornerRadius="14" Visibility="Collapsed"/>
      <Border CornerRadius="14" BorderThickness="1">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#80FFFFFF" Offset="0"/>
            <GradientStop Color="#14FFFFFF" Offset="0.6"/>
            <GradientStop Color="#40FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>
    </Grid>

    <!-- Title / artist -->
    <StackPanel x:Name="TitleBlock" Grid.Column="2" VerticalAlignment="Center">
      <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="13.5" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="ArtistText" Text="" FontSize="11" Foreground="#B8FFFFFF" Margin="0,1,0,0"
                 TextTrimming="CharacterEllipsis"/>
    </StackPanel>

    <!-- Up next: opens the music app's own queue (shown only for apps it can read) -->
    <Border x:Name="BtnUpNext" Grid.Column="2" Style="{StaticResource GlassButton}" Width="20" Height="20" CornerRadius="10"
            HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
      <Path x:Name="UpNextIcon" Width="9" Height="5" Stretch="Fill" Stroke="White" StrokeThickness="1.6"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L4.5,4.5 L9,0"
            RenderTransformOrigin="0.5,0.5"/>
    </Border>

    <!-- Progress / seek -->
    <Grid Grid.Column="2" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="27"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="27"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="PosText" Style="{StaticResource TimeText}" Text="0:00" HorizontalAlignment="Left"/>
      <Grid x:Name="SeekTrack" Grid.Column="1" Background="Transparent" Cursor="Hand" Margin="2,0">
        <Border Height="3.5" CornerRadius="1.75" Background="#38FFFFFF" VerticalAlignment="Center"/>
        <Border x:Name="SeekFill" Height="3.5" CornerRadius="1.75" VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#B3FFFFFF" Offset="0"/>
              <GradientStop Color="#FFFFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Border.RenderTransform>
            <ScaleTransform ScaleX="0"/>
          </Border.RenderTransform>
        </Border>
        <Ellipse x:Name="SeekThumb" Width="9" Height="9" Fill="White" Stroke="#33000000" StrokeThickness="0.5"
                 HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0">
          <Ellipse.RenderTransform>
            <TranslateTransform/>
          </Ellipse.RenderTransform>
        </Ellipse>
      </Grid>
      <TextBlock x:Name="DurText" Grid.Column="2" Style="{StaticResource TimeText}" Text="0:00" HorizontalAlignment="Right"/>
    </Grid>

    <!-- Transport buttons -->
    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border x:Name="BtnPrev" Style="{StaticResource GlassButton}" Width="28" Height="28" CornerRadius="14">
        <Path Width="11" Height="11" Stretch="Uniform" Fill="White" Data="M6,6 H8.2 V18 H6 Z M9.6,12 L18,6 V18 Z"/>
      </Border>
      <Border x:Name="BtnPlay" Style="{StaticResource GlassLens}" Width="34" Height="34" CornerRadius="17" Margin="4,0">
        <Path x:Name="PlayIcon" Width="12" Height="13" Stretch="Uniform" Fill="White" Margin="2,0,0,0"
              Data="M8,5 V19 L19,12 Z"/>
      </Border>
      <Border x:Name="BtnNext" Style="{StaticResource GlassButton}" Width="28" Height="28" CornerRadius="14">
        <Path Width="11" Height="11" Stretch="Uniform" Fill="White" Data="M15.8,6 H18 V18 H15.8 Z M6,6 L14.4,12 L6,18 Z"/>
      </Border>
    </StackPanel>

    <!-- Volume (controls the music app's own mixer volume, not Dota's) -->
    <Grid Grid.Column="4" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="17"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Viewbox Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Canvas Width="24" Height="24">
          <Path Fill="#E6FFFFFF" Data="M3,9 H7 L12,4.5 V19.5 L7,15 H3 Z"/>
          <Path x:Name="VolWave1" Stroke="#E6FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M15.5,9 A4,4 0 0 1 15.5,15"/>
          <Path x:Name="VolWave2" Stroke="#E6FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M18.5,6 A8,8 0 0 1 18.5,18"/>
        </Canvas>
      </Viewbox>
      <Grid x:Name="VolTrack" Grid.Column="1" Background="Transparent" Cursor="Hand">
        <Border Height="3.5" CornerRadius="1.75" Background="#38FFFFFF" VerticalAlignment="Center"/>
        <Border x:Name="VolFill" Height="3.5" CornerRadius="1.75" Background="#F2FFFFFF" VerticalAlignment="Center"
                RenderTransformOrigin="0,0.5">
          <Border.RenderTransform>
            <ScaleTransform ScaleX="0.5"/>
          </Border.RenderTransform>
        </Border>
        <Ellipse x:Name="VolThumb" Width="9" Height="9" Fill="White" Stroke="#33000000" StrokeThickness="0.5"
                 HorizontalAlignment="Left" VerticalAlignment="Center">
          <Ellipse.RenderTransform>
            <TranslateTransform/>
          </Ellipse.RenderTransform>
        </Ellipse>
      </Grid>
    </Grid>
  </Grid>
</Grid>
